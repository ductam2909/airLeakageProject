{
  "name": "airleakageproject",
  "private": true,
  "version": "0.0.11",
  "description": "Rò rỉ khí mâm xe",
  "author": "THACO",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently \"python backend/app.py\" \"vite\"",
    "backend": "python backend/app.py",
    "vite": "vite",
    "build": "vite build",
    "build:backend": "node scripts/build-backend.cjs",
    "prepare:electron": "npm run build && npm run build:backend",
    "builder": "npm run prepare:electron && electron-builder",
    "builder:dir": "npm run prepare:electron && electron-builder --dir",
    "builder:raw": "electron-builder",
    "pack": "npm run builder:dir",
    "dist": "npm run builder",
    "release:github": "npm run prepare:electron && electron-builder --publish always",
    "build:electron": "npm run dist",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.thaco.airleakage",
    "productName": "Air Leakage Project",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "ductam2909",
        "repo": "airLeakageProject",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Air-Leakage-Project-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@ant-design/charts": "^2.6.7",
    "@ant-design/icons": "^6.3.2",
    "@ant-design/plots": "^2.6.8",
    "antd": "^6.6.1",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "electron-updater": "^6.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "sass": "^1.102.0",
    "vite": "^8.2.0"
  }
}
